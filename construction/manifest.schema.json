{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/project0/blob/main/construction/manifest.schema.json",
  "title": "Project 0 provisional construction manifest",
  "description": "Structural bootstrap record only. This schema does not define canonical serialization, identity, admission, or Project 0 conformance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "proposalRef",
    "repository",
    "baseRef",
    "createdBy",
    "recordedAt",
    "visibility",
    "changeClass",
    "roadmapRefs",
    "summary",
    "sources",
    "contract",
    "declaredRelationships",
    "verification",
    "compatibility",
    "authority",
    "tensions",
    "rejectedAlternatives",
    "stopConditions",
    "identity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "project0.construction-manifest.v0"
    },
    "recordType": {
      "const": "construction_proposal"
    },
    "proposalRef": {
      "$ref": "#/$defs/stableRef"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "baseRef": {
      "description": "Exact external revision used as the proposal base. It is provenance, not Project 0 canonical identity.",
      "$ref": "#/$defs/stableRef"
    },
    "createdBy": {
      "$ref": "#/$defs/stableRef"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "visibility": {
      "enum": [
        "public",
        "restricted",
        "private",
        "mixed"
      ]
    },
    "changeClass": {
      "enum": [
        "constitutional",
        "structural",
        "domain",
        "adapter",
        "interface",
        "research"
      ]
    },
    "roadmapRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableRef"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termsChanged",
        "invariantRefs"
      ],
      "properties": {
        "termsChanged": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invariantRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^P0-I(?:[1-9]|1[0-9]|20)$"
          }
        }
      }
    },
    "declaredRelationships": {
      "description": "Interpretive relationship declarations over external refs. They are not admitted canonical graph edges.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "fromRef",
          "toRef"
        ],
        "properties": {
          "type": {
            "enum": [
              "derived_from",
              "quotes",
              "compresses",
              "revises",
              "depends_on",
              "supports",
              "contradicts",
              "qualifies",
              "observes",
              "answers",
              "asks",
              "rebuttal_to",
              "responds_to",
              "continues",
              "delegates",
              "consumes",
              "revokes",
              "permits_disclosure",
              "precedes",
              "overlaps",
              "supersedes"
            ]
          },
          "fromRef": {
            "$ref": "#/$defs/stableRef"
          },
          "toRef": {
            "$ref": "#/$defs/stableRef"
          },
          "basisRef": {
            "anyOf": [
              {
                "$ref": "#/$defs/stableRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "commands",
        "fixtures",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "partial",
            "passed",
            "failed"
          ]
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableRef"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "migration"
      ],
      "properties": {
        "effect": {
          "enum": [
            "none",
            "compatible",
            "migration_required",
            "breaking",
            "unknown"
          ]
        },
        "migration": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedAction",
        "scope",
        "basisRefs"
      ],
      "properties": {
        "requestedAction": {
          "enum": [
            "review",
            "merge",
            "tag"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "basisRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableRef"
          }
        }
      }
    },
    "tensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rejectedAlternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alternative",
          "reason"
        ],
        "properties": {
          "alternative": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "canonicalHash",
        "externalRefs"
      ],
      "properties": {
        "status": {
          "const": "provisional"
        },
        "canonicalHash": {
          "const": null
        },
        "externalRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableRef"
          }
        }
      }
    }
  },
  "$defs": {
    "stableRef": {
      "type": "string",
      "minLength": 1,
      "description": "Stable external URL, repository path at exact commit, or declared issue/record reference."
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "role"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/stableRef"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
