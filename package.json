{
  "dependencies": {
    "bs58": "^6.0.0",
    "json-canonicalize": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc --outDir .build",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test .build/tests/*.test.js",
    "conformance": "npm run build && node .build/scripts/conformance.js",
    "verify:fixtures": "python3 tests/verify_fixtures.py",
    "verify": "npm run check && npm test",
    "verify:all": "npm run verify && npm run verify:fixtures && npm run conformance",
    "world-encounter:stdio": "npm run build --silent && node .build/scripts/world-encounter-stdio.js"
  }
}
